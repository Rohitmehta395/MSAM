# ==============================================================================
# MSAM — Environment Variables Example
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NOTE: Do NOT commit .env.local or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Public Variables (exposed to client/browser, prefixed with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------

# Canonical site URL (default: http://localhost:3000)
# Used for canonical links, sitemaps, Open Graph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary cloud name (Optional during placeholder-only development)
# When omitted or empty, MediaImage automatically renders accessible aspect-stable PlaceholderBlocks.
# Required when delivering production media assets from Cloudinary.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# External donation hand-off URL (Optional)
# Used to link to external donation platforms if applicable
NEXT_PUBLIC_DONATION_URL=

# ------------------------------------------------------------------------------
# Server-Only Variables (never exposed to client or browser bundles)
# ------------------------------------------------------------------------------

# Cloudinary API key (Optional)
# Used for server-side media queries or administrative operations
CLOUDINARY_API_KEY=

# Cloudinary API secret (Optional)
# Used for server-side signed uploads and administrative operations
CLOUDINARY_API_SECRET=

# Form submission destination sink (Default: console)
# Options: console | email | crm
SUBMISSION_SINK=console
